# scripts/.deploy-remote.env.example — deploy-remote.sh 的配置模板
#
# 用法:
#   cp scripts/.deploy-remote.env.example scripts/.deploy-remote.env
#   # edit scripts/.deploy-remote.env 填真实值(此文件 gitignored,不入库)
#
# deploy-remote.sh 启动时自动 source scripts/.deploy-remote.env。
# shell env 变量(REMOTE_HOST=xxx ./scripts/deploy-remote.sh)覆盖此文件。

# ssh host —— ~/.ssh/config 别名(推荐,免得暴露 user@ip),或 user@host
REMOTE_HOST=carlos-web

# remote 对外 URL(nginx HTTPS 入口;脚本用它做外网 health 验证)
REMOTE_URL=https://remote.example.com

# 服务器部署目录(remote 二进制 + dist + start.sh 所在)
REMOTE_DIR=/data/web/everlasting
